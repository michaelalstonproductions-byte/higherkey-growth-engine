    "reset_demo_workspace",
    "archive_project_artifacts",
    "archive_generated_artifacts",
    "prune_stale_queue",
    "reconcile_apply",
    "backup_project",
    "delete_cache"
  ],
  "allow_arbitrary_file_access": false,
  "allow_arbitrary_command_execution": false,
  "max_import_file_size_mb": 20480,
  "allowed_import_extensions": [
    ".mp4",
    ".mov",
    ".m4v"
  ],
  "allowed_script_actions": [
    "archive_project_artifacts",
    "archive_test_media",
    "audio_school",
    "backup_project",
    "backfill_runtime_db",
    "build_media_cache",
    "build_observability_report",
    "build_runtime_snapshot",
    "build_task_snapshot",
    "cleanup_apply",
    "cleanup_plan",
    "color_school",
    "diagnostics",
    "enqueue_full_media_prep",
    "export_approved_posts",
    "export_social_packs",
    "local_api",
    "maintenance",
    "orchestrator",
    "project_size_report",
    "qa_full",
    "rebuild_metadata_index",
    "reconcile_apply",
    "reconcile_dry_run",
    "repair_project_media",
    "reset_demo_workspace",
    "restore_project",
    "run_pipeline",
    "run_task_worker",
    "security_check",
    "storage_report",
    "upgrade_project",
    "validate_project",
    "validate_data_contract",
    "vacuum_runtime_db",
    "launch_preflight",
    "worker_manage"
