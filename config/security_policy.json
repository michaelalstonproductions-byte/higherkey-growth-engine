{
  "version": 1,
  "local_only": true,
  "allowed_api_hosts": [
    "127.0.0.1",
    "localhost"
  ],
  "allowed_project_roots": [],
  "denied_project_roots": [
    "/",
    "/Users",
    "/Applications",
    "/System",
    "/Library"
  ],
  "allowed_runtime_dirs": [
    "analytics",
    "queue",
    "clips",
    "captions",
    "content_inbox",
    "logs",
    "out",
    "config"
  ],
  "protected_dirs": [
    "/",
    "/Applications",
    "/System",
    "/Library",
    "/usr",
    "/bin",
    "/sbin",
    "/private"
  ],
  "destructive_actions_require_confirmation": [
