{
  "name": "higherkey-growth-engine",
  "version": "5.3.1",
  "productName": "HigherKey Operator OS",
  "description": "HigherKey local-first autonomous growth engine desktop shell",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "electron:verify": "HK_ELECTRON_SMOKE=1 electron .",
    "dist:dir": "bash scripts/build_latest_desktop.sh --dir",
    "dist:unsigned": "bash scripts/build_latest_desktop.sh --dmg",
    "clean:dist": "rm -rf dist",
    "qa:full": "python3 scripts/run_full_qa.py",
    "release:notes": "python3 scripts/generate_release_notes.py",
    "app:open-latest": "bash scripts/open_latest_app.sh"
  },
  "build": {
    "appId": "com.higherkey.operatoros",
    "productName": "HigherKey Operator OS",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dashboard",
        "to": "app-assets/dashboard",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "growth_engine",
        "to": "app-assets/growth_engine",
        "filter": [
          "**/*",
          "!growth_strategy.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "scripts",
        "to": "app-assets/scripts",
        "filter": [
          "**/*",
          "!build_growth_strategy.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
      "from": "config",
      "to": "app-assets/config",
      "filter": [
        "**/*",
        "!desktop_runtime.json",
        "!project_manifest.json"
      ]
    },
      {
        "from": "README.md",
        "to": "app-assets/README.md"
      },
      {
        "from": "RELEASE_NOTES.md",
        "to": "app-assets/RELEASE_NOTES.md"
      },
      {
        "from": "DEMO_CHECKLIST.md",
        "to": "app-assets/DEMO_CHECKLIST.md"
      },
      {
        "from": "CLIENT_HANDOFF_GUIDE.md",
        "to": "app-assets/CLIENT_HANDOFF_GUIDE.md"
      },
      {
        "from": "CLIENT_QUICK_START.md",
        "to": "app-assets/CLIENT_QUICK_START.md"
      },
      {
        "from": "BETA_READINESS_CHECKLIST.md",
        "to": "app-assets/BETA_READINESS_CHECKLIST.md"
      },
      {
        "from": "TRIAL_LIMITATIONS.md",
        "to": "app-assets/TRIAL_LIMITATIONS.md"
      },
      {
        "from": "TRIAL_DELIVERY_CHECKLIST.md",
        "to": "app-assets/TRIAL_DELIVERY_CHECKLIST.md"
      },
      {
        "from": "CLIENT_TRIAL_QA_SUMMARY.md",
        "to": "app-assets/CLIENT_TRIAL_QA_SUMMARY.md"
      },
      {
        "from": "build/icon-placeholder.svg",
        "to": "app-assets/build/icon-placeholder.svg"
      },
      {
        "from": "build/ICON_NOTES.md",
        "to": "app-assets/build/ICON_NOTES.md"
      },
      {
        "from": "build/icon.png",
        "to": "app-assets/build/icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1"
  }
}
